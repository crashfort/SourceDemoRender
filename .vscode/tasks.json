{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild svr.slnx /t:Build /noLogo /clp:ErrorsOnly;Summary",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": false,
                "clear": true,
                "focus": true,
                "showReuseMessage": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "launch",
            "type": "shell",
            "command": "${workspaceFolder}\\bin\\svr_launcher64.exe",
            "args": [
                "cstrike_steam.ini",
            ],
            "options": {
                "cwd": "${workspaceFolder}\\bin",
            },
            "problemMatcher": []
        }
    ]
}
